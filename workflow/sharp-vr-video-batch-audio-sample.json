":"INT","widget":{"name":"frame_load_cap"},"link":null},{"localized_name":"skip_first_frames","name":"skip_first_frames","type":"INT","widget":{"name":"skip_first_frames"},"link":null},{"localized_name":"select_every_nth","name":"select_every_nth","type":"INT","widget":{"name":"select_every_nth"},"link":null},{"localized_name":"format","name":"format","shape":7,"type":"COMBO","widget":{"name":"format"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[16]},{"localized_name":"frame_count","name":"frame_count","type":"INT","links":null},{"localized_name":"audio","name":"audio","type":"AUDIO","links":null},{"localized_name":"video_info","name":"video_info","type":"VHS_VIDEOINFO","links":[18]}],"properties":{"cnr_id":"comfyui-videohelpersuite","ver":"1.7.9","Node name for S&R":"VHS_LoadVideoPath"},"widgets_values":{"video":"","force_rate":0,"custom_width":0,"custom_height":0,"frame_load_cap":0,"skip_first_frames":0,"select_every_nth":1,"format":"AnimateDiff","videopreview":{"hidden":false,"paused":false,"params":{"filename":"","type":"path","format":"video/","force_rate":0,"custom_width":0,"custom_height":0,"frame_load_cap":0,"skip_first_frames":0,"select_every_nth":1}}},"widgets_values_named":{"video":"","force_rate":0,"custom_width":0,"custom_height":0,"frame_load_cap":0,"skip_first_frames":0,"select_every_nth":1,"format":"AnimateDiff","videopreview":{"hidden":false,"paused":false,"params":{"filename":"","type":"path","format":"video/","force_rate":0,"custom_width":0,"custom_height":0,"frame_load_cap":0,"skip_first_frames":0,"select_every_nth":1}}},"color":"#223","bgcolor":"#335"},{"id":7,"type":"Note","pos":[418.21745608151787,684.1335932295124],"size":[501.8358396853939,327.44388150659506],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["BASIC GUIDE:\n\n* I'd keep focal length 35mm (works well most footage).\n\n* For custom_baseline_mm, enter your IPD ideally, for most people its somewhere between 50-75mm.\n\n* custom_convergence_m dictates how close/far the objects in the scene feel to your eyes, in VR i find 3 meters (3.0 here) to feel best for stereoscopy 3D effect of shots with people. Too low = eye-strain. Too high = weaker 3D effect.\n\n* You can dolly in a bit closer to the center of the scene with the camera_dolly_m value. I find +0.05 m to be a meaningful limit, too much dolly-in and you're just getting too close and clipping into geometry of the center objects.\n\n* You can orbit off-center around the center of the scene left/right/higher/lower with the two camera_orbit_* values. +yaw = orbiting to higher than center, -yaw = orbiting to lower than center, +pitch = orbiting to the right side of center, -pitch = orbiting to the left side of center. I find +/-1.0 degree in any orbit axis to be a meaningful limit, too much orbiting off-center and you start seeing a ton of gaussian splatting reconstruction artifacts.\n\nTry the Dolly/orbit animation options! They are really cool.\n\nThe rest you can keep default, or fiddle around."],"widgets_values_named":{"text":"BASIC GUIDE:\n\n* I'd keep focal length 35mm (works well most footage).\n\n* For custom_baseline_mm, enter your IPD ideally, for most people its somewhere between 50-75mm.\n\n* custom_convergence_m dictates how close/far the objects in the scene feel to your eyes, in VR i find 3 meters (3.0 here) to feel best for stereoscopy 3D effect of shots with people. Too low = eye-strain. Too high = weaker 3D effect.\n\n* You can dolly in a bit closer to the center of the scene with the camera_dolly_m value. I find +0.05 m to be a meaningful limit, too much dolly-in and you're just getting too close and clipping into geometry of the center objects.\n\n* You can orbit off-center around the center of the scene left/right/higher/lower with the two camera_orbit_* values. +yaw = orbiting to higher than center, -yaw = orbiting to lower than center, +pitch = orbiting to the right side of center, -pitch = orbiting to the left side of center. I find +/-1.0 degree in any orbit axis to be a meaningful limit, too much orbiting off-center and you start seeing a ton of gaussian splatting reconstruction artifacts.\n\nTry the Dolly/orbit animation options! They are really cool.\n\nThe rest you can keep default, or fiddle around."},"color":"#432","bgcolor":"#653"},{"id":9,"type":"VHS_BatchManager","pos":[513.2227478839575,-93.51968082023329],"size":[256.9296875,58],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"frames_per_batch","name":"frames_per_batch","type":"INT","widget":{"name":"frames_per_batch"},"link":null}],"outputs":[{"localized_name":"meta_batch","name":"meta_batch","type":"VHS_BatchManager","links":[7,8,9,10]}],"properties":{"cnr_id":"comfyui-videohelpersuite","ver":"1.7.9","Node name for S&R":"VHS_BatchManager"},"widgets_values":{"frames_per_batch":48,"count":0},"widgets_values_named":{"frames_per_batch":48,"count":0},"color":"#323","bgcolor":"#535"},{"id":10,"type":"Note","pos":[508.9858294916103,-287.3675091913307],"size":[263.7948206645889,151.4234535867904],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["NOTES: \n\nThis breaks up longer input videos into chunks of frames before reassembling them at the end, to allow for theoretically any length of video to be processed without hitting RAM limits.\n\nLower the per-batch frame-count further if your RAM can't handle the default batch size. "],"widgets_values_named":{"text":"NOTES: \n\nThis breaks up longer input videos into chunks of frames before reassembling them at the end, to allow for theoretically any length of video to be processed without hitting RAM limits.\n\nLower the per-batch frame-count further if your RAM can't handle the default batch size. "},"color":"#323","bgcolor":"#535"},{"id":11,"type":"TextBoxConcatenate","pos":[-849.4240394064649,208.86628114251926],"size":[530.052861035983,154.90920942919013],"flags":{},"order":4,"mode":0,"input